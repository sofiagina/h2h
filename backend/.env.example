# Скопировать в .env. Файл .env в git не попадает.

# База
DB_NAME=h2h
DB_USER=h2h
DB_PASSWORD=h2h
# Для приложения, запущенного вне docker:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/h2h

# Файлы (MinIO локально, S3-совместимое хранилище в проде)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=h2hminio
S3_SECRET_KEY=h2hminio123
S3_BUCKET=h2h

# Почта: локально Mailpit, в проде — настоящий SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@tunele.ru

# JWT. В проде — длинная случайная строка, например: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Платежи: fake — заглушка с кнопками «Оплатить» и «Отклонить»; yookassa — боевой провайдер
PAYMENTS_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Публичный адрес фронта: на него возвращает платёжная страница
PUBLIC_BASE_URL=http://localhost:5173
