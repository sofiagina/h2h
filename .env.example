# true (по умолчанию) — фронт работает на моках в браузере, бэкенд не нужен.
# false — запросы идут в настоящий API: /api/v1/...
VITE_USE_MOCK=true

# Адрес API, если он на другом домене. Пусто = тот же домен (в dev работает прокси из vite.config.ts).
VITE_API_URL=

# Куда dev-прокси отправляет запросы (читается vite.config.ts, не попадает в бандл).
# /api/v1/auth/* и /api/v1/me — сервис identity, остальное /api — основной бэкенд.
H2H_IDENTITY=http://localhost:8081
H2H_BACKEND=http://localhost:8080
